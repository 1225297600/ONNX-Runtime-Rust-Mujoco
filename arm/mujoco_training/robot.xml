<mujoco model="robot">
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicit"/>

  <size njmax="100" nconmax="100"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.1 0.2 0.4" width="512" height="512"/>
    <texture name="ground" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" width="512" height="512"/>
    <material name="ground" texture="ground" texrepeat="8 8" reflectance="0.2"/>
    <material name="arm_mat" rgba="0.8 0.2 0.2 1"/>
    <material name="joint_mat" rgba="0.2 0.2 0.8 1"/>
    <material name="gripper_mat" rgba="0.9 0.6 0.2 1"/>
  </asset>

  <worldbody>
    <light name="sun" pos="0 0 5" dir="0 0 -1" castshadow="true"/>
    <geom name="ground" type="plane" size="10 10 0.1" material="ground"/>

    <!-- 固定基座 -->
    <body name="base" pos="0 0 0.05">
      <!-- base 只做视觉，不参与碰撞 -->
      <geom name="base_geom" type="cylinder" size="0.15 0.05"
            rgba="0.3 0.3 0.3 1" contype="0" conaffinity="0"/>

      <!-- ===== J1: 腰部回转 (绕 Z) ===== -->
      <body name="link1" pos="0 0 0.05">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
        <geom name="link1_geom" type="cylinder" size="0.06 0.08"
              pos="0 0 0.08" material="arm_mat"/>
        <!-- 关节圆柱只做视觉，不参与碰撞 -->
        <geom name="joint1_geom" type="cylinder" size="0.085 0.025"
              pos="0 0 0" material="joint_mat" contype="0" conaffinity="0"/>

        <!-- ===== J2: 肩部俯仰 (绕 Y) ===== -->
        <body name="link2" pos="0 0 0.16">
          <joint name="joint2" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
          <geom name="link2_geom" type="cylinder" size="0.05 0.10"
                pos="0 0 0.10" material="arm_mat"/>
          <geom name="joint2_geom" type="cylinder" size="0.065 0.03"
                pos="0 0 0" euler="1.57 0 0" material="joint_mat"
                contype="0" conaffinity="0"/>

          <!-- ===== J3: 肘部俯仰 (绕 Y) ===== -->
          <body name="link3" pos="0 0 0.20">
            <joint name="joint3" type="hinge" axis="0 1 0" range="-2.4 2.4"/>
            <geom name="link3_geom" type="cylinder" size="0.045 0.09"
                  pos="0 0 0.09" material="arm_mat"/>
            <geom name="joint3_geom" type="cylinder" size="0.058 0.028"
                  pos="0 0 0" euler="1.57 0 0" material="joint_mat"
                  contype="0" conaffinity="0"/>

            <!-- ===== J4: 腕部俯仰 (绕 Y) ===== -->
            <body name="link4" pos="0 0 0.18">
              <joint name="joint4" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
              <geom name="link4_geom" type="cylinder" size="0.04 0.06"
                    pos="0 0 0.06" material="arm_mat"/>
              <geom name="joint4_geom" type="cylinder" size="0.05 0.025"
                    pos="0 0 0" euler="1.57 0 0" material="joint_mat"
                    contype="0" conaffinity="0"/>

              <!-- ===== J5: 腕部滚转 (绕 Z) ===== -->
              <body name="link5" pos="0 0 0.12">
                <joint name="joint5" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
                <geom name="link5_geom" type="cylinder" size="0.035 0.03"
                      pos="0 0 0.03" material="arm_mat"/>
                <geom name="joint5_geom" type="cylinder" size="0.045 0.02"
                      pos="0 0 0" material="joint_mat" contype="0" conaffinity="0"/>

                <!-- 末端夹爪 -->
                <body name="gripper" pos="0 0 0.06">
                  <geom name="gripper_base_geom" type="box" size="0.035 0.04 0.02"
                        material="gripper_mat"/>
                  <geom name="finger1_geom" type="box" size="0.012 0.012 0.035"
                        pos="0 0.025 0.055" material="gripper_mat"/>
                  <geom name="finger2_geom" type="box" size="0.012 0.012 0.035"
                        pos="0 -0.025 0.055" material="gripper_mat"/>
                  <site name="ee_site" pos="0 0 0.06" size="0.008" rgba="0 1 0 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="act1" joint="joint1" kp="120" kv="12"/>
    <position name="act2" joint="joint2" kp="120" kv="12"/>
    <position name="act3" joint="joint3" kp="100" kv="10"/>
    <position name="act4" joint="joint4" kp="80"  kv="8"/>
    <position name="act5" joint="joint5" kp="50"  kv="5"/>
  </actuator>
</mujoco>